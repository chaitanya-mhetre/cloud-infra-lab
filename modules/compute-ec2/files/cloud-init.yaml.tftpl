#cloud-config
# Rendered by Terraform (modules/compute-ec2). Runs once on first boot.
package_update: true
packages:
  - docker
  - jq

write_files:
%{ for fname, content in files ~}
  - path: ${app_dir}/${fname}
    encoding: b64
    permissions: "0750"
    content: ${base64encode(content)}
%{ endfor ~}

runcmd:
  - systemctl enable --now docker
  # Compose v2 plugin (not packaged for AL2023): pinned release, arm64.
  - mkdir -p /usr/local/lib/docker/cli-plugins
  - curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64
  - chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  - mkdir -p ${app_dir}/certbot/www ${app_dir}/certbot/conf
%{ if domain_name != "" ~}
  # First certificate via the standalone challenge (nginx isn't running yet).
  - docker run --rm -p 80:80 -v ${app_dir}/certbot/conf:/etc/letsencrypt certbot/certbot certonly --standalone --non-interactive --agree-tos -m ${acme_email} -d ${domain_name}
  # Renew twice a day via the webroot served by nginx; reload nginx after.
  - echo '17 3,15 * * * root docker run --rm -v ${app_dir}/certbot/conf:/etc/letsencrypt -v ${app_dir}/certbot/www:/var/www/certbot certbot/certbot renew --webroot -w /var/www/certbot --quiet && docker compose -f ${app_dir}/docker-compose.yml exec nginx nginx -s reload' > /etc/cron.d/certbot-renew
%{ endif ~}
%{ if image_tag != "" ~}
  - ${app_dir}/host-deploy.sh ${image_tag}
%{ else ~}
  # No initial tag: the host boots idle and waits for the first `make deploy ENV=dev IMAGE_TAG=<sha>`.
  - echo "no initial image tag; waiting for first deploy"
%{ endif ~}
